{
  "expo": {
    "name": "Kinnesto",
    "slug": "kinnesto",
    "scheme": "kinnesto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kinnesto",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kinnesto needs your photos so you can add them to your profile and listings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.kinnesto",
      "adaptiveIcon": {
        "backgroundColor": "#121119",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Kinnesto: PG, Flats & Flatmates in Mumbai",
      "description": "Find PGs, flats, hostels, co-living and stays across Mumbai, and match with flatmates on budget, timing and lifestyle. Free, no brokerage."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121119",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinnesto needs your photos so you can add them to your profile and listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7dda2c53-4201-4612-a732-223ae036729d"
      }
    },
    "owner": "shashankpandey14"
  }
}
